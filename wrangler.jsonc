// Cloudflare Worker: serves the React app as static assets and runs the
// /api/* backend and /s/* share links from worker/index.ts. Run `npm run deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exam-practice",
  "compatibility_date": "2026-09-01",
  "main": "./worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // "/", /s/<code> share links and /games/<id> game links: the Worker adds link-preview tags for chat apps.
    "run_worker_first": ["/", "/api/*", "/s/*", "/games/*"],
  },
  "vars": {
    // OAuth 2.0 Web client ID from Google Cloud Console (public, safe to commit).
    // Looks like: 1234567890-abc123.apps.googleusercontent.com
    "GOOGLE_CLIENT_ID": "284460403925-crbmtochtrhan6v52k9mm5lri2et27no.apps.googleusercontent.com",
  },
  // Accounts and saved scores. Local dev uses a local copy and ignores the ID.
  // Before deploying: run `npx wrangler d1 create exam-practice` and paste the
  // database_id it prints here, then `npm run db:migrate:remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exam-practice",
      "database_id": "26b1c301-6f16-4656-95d9-b56de5ebfac3",
      "migrations_dir": "migrations",
    },
  ],
  // SESSION_SECRET is a secret, never put it here:
  //   local dev  -> .dev.vars
  //   production -> npx wrangler secret put SESSION_SECRET
}
