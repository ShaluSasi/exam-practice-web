// Cloudflare Worker: serves the React app as static assets and runs the
// /api/* backend and /s/* share links from worker/index.ts. Run `npm run deploy`.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "exam-practice",
  "compatibility_date": "2026-09-01",
  "main": "./worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Every page goes through the Worker: link previews, search tags, the main-address redirect and real 404s (worker/seo.ts).
    "run_worker_first": ["/*", "!/assets/*", "!/img/*", "!/og/*", "!/favicon.svg"],
  },
  "vars": {
    // OAuth 2.0 Web client ID from Google Cloud Console (public, safe to commit).
    // Looks like: 1234567890-abc123.apps.googleusercontent.com
    "GOOGLE_CLIENT_ID": "284460403925-crbmtochtrhan6v52k9mm5lri2et27no.apps.googleusercontent.com",
    // Oldest app build (app-version.json "build") the API still supports. Raise it when a
    // release changes the API in a way older apps cannot handle: they then show "Update required".
    "MIN_APP_BUILD": "2",
    // Google accounts (comma-separated) that are always admins and can open the configuration page.
    "ADMIN_EMAILS": "itssreeju@gmail.com,toshalusasi@gmail.com",
    // What guests (not signed in) may do before they are asked to sign in. -1 means unlimited, 0 means none.
    // Questions a guest may answer on one device (a practice round is 20).
    "GUEST_FREE_QUESTIONS": "20",
    // Times a guest may open a game on one device.
    "GUEST_FREE_GAMES": "3",
    // New practice rounds guests may start from one network a day, however many devices share it.
    "GUEST_ROUNDS_PER_DAY": "5",
  },
  // Accounts and saved scores. Local dev uses a local copy and ignores the ID.
  // Before deploying: run `npx wrangler d1 create exam-practice` and paste the
  // database_id it prints here, then `npm run db:migrate:remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "exam-practice",
      "database_id": "066960fc-9b13-4ecc-b24a-d8b1c1c98611",
      "migrations_dir": "migrations",
    },
  ],
  // SESSION_SECRET is a secret, never put it here:
  //   local dev  -> .dev.vars
  //   production -> npx wrangler secret put SESSION_SECRET
}
